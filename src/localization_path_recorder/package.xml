<?xml version="1.0"?>
<package format="3">
  <name>localization_path_recorder</name>
  <version>0.1.0</version>
  <description>Record the localized base_link trajectory in the map frame</description>
  <maintainer email="zhoujinghao188@gmail.com">Jinghao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
